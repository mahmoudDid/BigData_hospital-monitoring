# ---------- Image versions (Kafka, kafdrop, nifi, Spark, Postgres) ----------
KAFKA_VERSION=7.8.3
SPARK_VERSION=3.5.1
POSTGRES_VERSION=16-alpine
NIFI_VERSION=2.12.0
KAFDROP_VERSION=4.0.2

# ---------- Kafka (KRaft, single broker) ----------
KAFKA_CLUSTER_ID=1L6g7nGhU-eAKfL--X25wo

# ---------- NiFi (UI: https://localhost:8443/nifi) ----------
NIFI_USERNAME=admin
# password and sensitive props key must be at least 12 characters
NIFI_PASSWORD=nifipassword123
NIFI_SENSITIVE_PROPS_KEY=nifisensitivekey123
NIFI_JVM_HEAP_MAX=2g

# ---------- Spark: what EACH of the 2 workers gets (total = 2 x this) ----------
SPARK_WORKER_CORES=1
SPARK_WORKER_MEMORY=1g

# ---------- PostgreSQL ----------
POSTGRES_DB=hospital_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres